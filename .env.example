# Copy to .env.local and fill in. Never commit .env.local.
# No NEXT_PUBLIC_ prefix = server-only, never sent to the browser.

# Which AI to use: "gemini" or "claude"
AI_PROVIDER=gemini

# https://aistudio.google.com/apikey
GEMINI_API_KEY=

# https://platform.claude.com/settings/keys
ANTHROPIC_API_KEY=

# true = fake data after 800ms, no API calls (great for building UI)
AI_MOCK=false
