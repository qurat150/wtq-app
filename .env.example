# Copy to .env.local and fill in the key. Never commit .env.local.
# No NEXT_PUBLIC_ prefix = server-only, never sent to the browser.

# Model provider: "gemini" (Google AI Studio, free tier) or "claude" (Anthropic)
AI_PROVIDER=gemini

# Model ID. Competition-allowed values: gemini-3.5-flash-lite, gemini-3.1-flash-lite (gemini),
# claude-haiku-4-5 (claude). With gemini, gemini-3.1-flash-lite is also used as the
# automatic fallback when the primary model is overloaded.
MODEL_NAME=gemini-3.5-flash-lite

# https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# Only needed if AI_PROVIDER=claude
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# true = no API calls; returns the built-in sample bill (for UI work without quota)
AI_MOCK=false
